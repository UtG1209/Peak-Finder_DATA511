# Copy to .env (git-ignored) and fill in only what YOUR lane needs. See docs/CREDENTIALS.md.
# Used by the Python pipeline only. The browser app never sees a key.

# Lane 2 - drive times (free key: https://openrouteservice.org/dev/#/signup)
# HeiGIT ORS API key: https://account.heigit.org/
ORS_API_KEY=

# Lane 2 - gas prices (free key: https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Lane 2 - hotel and meals per diem (free api.data.gov key: https://api.data.gov/signup/)
GSA_API_KEY=

# Lane 1/2 - optional: NPS API for fees, park pages and alerts (free: https://www.nps.gov/subjects/developer/get-started.htm)
NPS_API_KEY=

# Lane 2 - optional: higher DOT/Socrata rate limit (free app token from data.transportation.gov)
SOCRATA_APP_TOKEN=

# Wikimedia asks automated clients to identify themselves. Use "PeakFinderDATA511/0.1 (<your contact>)".
COMMONS_USER_AGENT=
